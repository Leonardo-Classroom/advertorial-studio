# 複製成 .env 後填入實際金鑰。.env 已列入 .gitignore。
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
# 開發伺服器預設埠號（python manage.py runserver 不帶參數時使用）。
RUNSERVER_PORT=5860

# --- 生成模型（Azure AI Services，OpenAI 相容 Responses API）---
LLM_BASE_URL=https://leo-test-0627-ai.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4
# 評審模型獨立設定。比較兩個生成模型時，改題的人必須固定，
# 否則量到的是「模型比較欣賞自己寫的東西」。留空則沿用 LLM_MODEL。
LLM_JUDGE_MODEL=gpt-5.4
LLM_TIMEOUT=180
# 某些推理模型不接受 temperature，設 0 就不送出。
LLM_SEND_TEMPERATURE=0
LLM_TEMPERATURE=0.8

# --- 向量模型 ---
# 此 Azure 資源沒有部署 text-embedding-3-*，改用 Cohere Embed v4。
# 已實測：原生 1536 維、支援 dimensions 縮維、單次批次上限 96 筆、
# input_type 接受 'text' / 'query' / 'document'。
EMBED_MODEL=embed-v-4-0
EMBED_DIMENSIONS=1024
EMBED_BATCH_SIZE=96
EMBED_CONCURRENCY=4
# 免費層速率上限：10 requests / 60 秒（429 RateLimitReached）。
EMBED_RPM=10
# 每篇文章送進向量模型的字數。RPM 受限時，縮短它＝每次請求塞更多篇＝索引更快。
EMBED_INDEX_CHARS=350

# 向量後端：local = 本機 GPU 跑模型（無額度限制）；api = 走 Azure/Cohere。
# 預設 local，因為遠端免費層每天只有 50 次請求（約 850 篇），索引全語料要數十天。
EMBED_BACKEND=local
EMBED_LOCAL_MODEL=BAAI/bge-m3
EMBED_LOCAL_DEVICE=cuda
EMBED_LOCAL_BATCH=64

# --- 語料來源 ---
CORPUS_ROOT=/mnt/d/OneDrive/Desktop/Alan/news report/dataset
